{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectfile.org/schema/conformance/interpolation.json",
  "title": "projectfile interpolation conformance vector",
  "type": "object",
  "required": ["description", "document", "cases"],
  "additionalProperties": false,
  "properties": {
    "description": { "type": "string", "minLength": 1 },
    "document": { "$ref": "https://projectfile.org/schema/v1.json" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["in", "out"],
        "additionalProperties": false,
        "properties": {
          "in": { "type": "string" },
          "out": { "type": "string" },
          "lines": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
